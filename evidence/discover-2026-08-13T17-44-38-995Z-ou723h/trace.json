    {
      "id": "step-4-adcce3",
      "action": "extract",
      "description": "Read the member's current savings balance",
      "rationale": "The accounts table has no test ids; targeting the Savings row by its label text and taking the last cell (Balance column) is robust to unrelated column-width/style changes, with an xpath fallback keyed to the same label.",
      "target": {
        "description": "Savings balance cell",
        "frame": [
          "#ctl00_mainFrame"
        ],
        "strategies": [
          {
            "kind": "css",
            "priority": 0,
            "value": "tr:has-text(\"Savings\") td:last-child",
            "rationale": "row selected by its own label text, balance is the last column of that row"
          },
          {
            "kind": "xpath",
            "priority": 1,
            "value": "//tr[td[1][normalize-space()=\"Savings\"]]/td[3]",
            "rationale": "structural fallback keyed to the same Savings label"
          }
        ]
      },
      "extractAs": "savingsBalance",
      "risk": "safe",
      "requiresConfirmation": false,
      "dialogPolicy": "none",
      "observationBefore": {
        "url": "http://localhost:4178/dashboard",
        "screenshot": "evidence/discover-2026-08-13T17-44-38-995Z-ou723h/screenshots/1786643128244_before.png"
