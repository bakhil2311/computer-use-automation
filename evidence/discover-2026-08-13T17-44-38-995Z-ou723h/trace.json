          },
          {
            "kind": "css",
            "priority": 1,
            "value": "#ctl00_det_btnOpenSub",
            "rationale": "fallback to legacy generated id"
          }
        ]
      },
      "risk": "irreversible",
      "requiresConfirmation": true,
      "dialogPolicy": "accept",
      "observationBefore": {
        "url": "http://localhost:4178/dashboard",
        "screenshot": "evidence/discover-2026-08-13T17-44-38-995Z-ou723h/screenshots/1786643272957_before.png"
      },
